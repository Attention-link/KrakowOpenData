<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Infrastructure: repository implementations and data-source adapters (GTFS, GTFS-RT, IMGW, GIOŚ, NFZ, OpenStreetMap, city Open Data API).
    Uses only the ASP.NET Core shared framework (HttpClientFactory, Options, Logging, DI) – no NuGet packages.
  -->
  <PropertyGroup>
    <RootNamespace>KrakowOpenData.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KrakowOpenData.Application\KrakowOpenData.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Seed snapshots of the OpenStreetMap downloads (street lamps, amenities, parks and other places). They are the starting data on a
      machine that has never downloaded them (or cannot reach Overpass), so the app works from the first start. Fresh downloads replace them.
      Refresh with: copy the files from the cache folder (see KrakowData:CacheDirectory) into Seed/ and commit.
    -->
    <EmbeddedResource Include="Seed\*.json" LogicalName="Seed.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KrakowOpenData.Infrastructure.Tests" />
    <InternalsVisibleTo Include="KrakowOpenData.Api.Tests" />
  </ItemGroup>
</Project>
