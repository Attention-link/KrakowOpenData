<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Typed .NET client for KrakowOpenData.Api. Ships as a NuGet package (dotnet pack) together with
    KrakowOpenData.Contracts. Only dependency: Microsoft.Extensions.Http (HttpClientFactory + DI).
  -->
  <PropertyGroup>
    <RootNamespace>KrakowOpenData.Client</RootNamespace>
    <IsPackable>true</IsPackable>
    <!-- XML docs give consumers IntelliSense; missing-comment warnings are not useful here. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>KrakowOpenData.Client</PackageId>
    <Description>Typed HTTP client for the Kraków Open Data API: transit, air quality, rivers, districts, amenities, city services and Open Data tables.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KrakowOpenData.Contracts\KrakowOpenData.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="KrakowOpenData.Api.Tests" />
  </ItemGroup>
</Project>
