@page "/open-data"
@page "/open-data/{Key}"
@inject IKrakowOpenDataClient Api
@inject NavigationManager Nav

<PageHeader Category="@T["cat.Society"]" Title="@T["odp.title"]" PageTitleText="@T["nav.openData"]"
            Description="@T["odp.lede"]" Source="@T["odp.source"]" />

<LoadState IsLoading="_loadingTables" Error="@_tablesError" IsEmpty="_tables.Count == 0" OnRetry="LoadTablesAsync">
    <div class="toolbar">
        <div class="search">
            <select aria-label="@T["odp.choose"]" value="@Key" @onchange="OnTableChanged">
                <option value="">@T["odp.choose"]</option>
                @foreach (var group in _tables.GroupBy(t => t.Category))
                {
                    <optgroup label="@T.Or("cat." + group.Key, group.Key)">
                        @foreach (var t in group)
                        {
                            <option value="@t.Key">@TableTitle(t.Key, t.Title)</option>
                        }
                    </optgroup>
                }
            </select>
            @if (_rows is not null)
            {
                <input placeholder="@T["odp.filter"]" aria-label="@T["odp.filter"]" @bind="_filter" @bind:event="oninput" />
            }
        </div>
    </div>

    @if (string.IsNullOrEmpty(Key))
    {
        <div class="grid">
            @foreach (var group in _tables.GroupBy(t => t.Category))
            {
                <article class="card">
                    <h3>@T.Or("cat." + group.Key, group.Key)</h3>
                    <ul class="plain">
                        @foreach (var t in group)
                        {
                            <li><a href="open-data/@t.Key">@TableTitle(t.Key, t.Title)</a></li>
                        }
                    </ul>
                </article>
            }
        </div>
    }
    else
    {
        <LoadState IsLoading="_loadingRows" Error="@_rowsError" IsEmpty="_rows is null || _rows.Rows.Count == 0" OnRetry="LoadRowsAsync">
            @if (_rows is not null)
            {
                var visible = Visible().ToList();
                <p class="muted small">
                    @T.F("odp.count", visible.Count, _rows.Rows.Count)
                    @if (_rows.Truncated) { <span> · @T.F("odp.truncated", RowLimit)</span> }
                    · <a href="@_rows.ApiUrl" target="_blank" rel="noopener">@T["odp.api"]</a>
                    · @_rows.Source
                </p>
                @if (visible.Count == 0)
                {
                    <div class="alert alert-secondary">@T["odp.noMatch"]</div>
                }
                <div class="table-scroll">
                    <table class="table table-striped table-hover align-middle">
                        <thead><tr>@foreach (var c in _rows.Columns) { <th>@c</th> }</tr></thead>
                        <tbody>
                            @foreach (var row in visible.Take(DisplayLimit))
                            {
                                <tr>@foreach (var c in _rows.Columns) { <td class="small">@(row.TryGetValue(c, out var v) ? v : null)</td> }</tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (visible.Count > DisplayLimit)
                {
                    <p class="muted small">@T.F("odp.shown", DisplayLimit)</p>
                }
            }
        </LoadState>
    }
</LoadState>

@code {
    private const int RowLimit = 2000;
    private const int DisplayLimit = 300;

    [Parameter] public string? Key { get; set; }

    private List<OpenDataTableDto> _tables = [];
    private bool _loadingTables = true;
    private string? _tablesError;

    private OpenDataRowsDto? _rows;
    private bool _loadingRows;
    private string? _rowsError;
    private string? _filter;
    private string? _loadedKey;

    protected override Task OnInitializedAsync() => LoadTablesAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (Key != _loadedKey) await LoadRowsAsync();
    }

    private async Task LoadTablesAsync()
    {
        _loadingTables = true;
        _tablesError = null;
        try { _tables = (await Api.OpenData.GetTablesAsync()).ToList(); }
        catch (Exception ex) { _tablesError = ex.Message; }
        finally { _loadingTables = false; }
    }

    private async Task LoadRowsAsync()
    {
        _loadedKey = Key;
        _rows = null;
        _filter = null;
        if (string.IsNullOrEmpty(Key)) return;

        _loadingRows = true;
        _rowsError = null;
        try
        {
            _rows = await Api.OpenData.GetRowsAsync(Key, RowLimit);
            if (_rows is null) _rowsError = T["odp.unknown"];
        }
        catch (Exception ex) { _rowsError = ex.Message; }
        finally { _loadingRows = false; }
    }

    private void OnTableChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        Nav.NavigateTo(string.IsNullOrEmpty(key) ? "open-data" : "open-data/" + Uri.EscapeDataString(key));
    }

    private IEnumerable<IReadOnlyDictionary<string, string?>> Visible()
    {
        if (_rows is null) return [];
        if (string.IsNullOrWhiteSpace(_filter)) return _rows.Rows;
        var needle = SearchText.Normalize(_filter);
        return _rows.Rows.Where(r => r.Values.Any(v => v is not null && SearchText.Normalize(v).Contains(needle, StringComparison.Ordinal)));
    }

    // Table titles are translated by key; the English title from the API is the fallback.
    private string TableTitle(string key, string title) => T.Or("odt." + key, title);
}
