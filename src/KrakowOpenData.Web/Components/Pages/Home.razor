@page "/"

<PageTitle>@T.F("page.titleFormat", T["nav.home"])</PageTitle>

<header class="page-header">
    <h1>@T["start.title"]</h1>
    <p class="lede">@T["start.lede"]</p>
</header>

<div class="row g-4">
    <div class="col-md-6 col-xl-4">
        <a class="card h-100 start-card text-decoration-none" href="catalog">
            <div class="start-icon bg-secondary">&#9783;</div>
            <h2>@T["start.catalog.title"]</h2>
            <p class="text-muted">@T["start.catalog.text"]</p>
            <span class="btn btn-outline-primary btn-sm mt-auto align-self-start">@T["home.open"]</span>
        </a>
    </div>
    @* Separate pages, not Blazor routes: target="_top" makes the browser load them instead of the router answering "Not found". *@
    <div class="col-md-6 col-xl-4">
        <a class="card h-100 start-card text-decoration-none" href="/safety/index.html" target="_top">
            <div class="start-icon bg-primary">&#9728;</div>
            <h2>@T["start.resident.title"]</h2>
            <p class="text-muted">@T["start.resident.text"]</p>
            <span class="btn btn-outline-primary btn-sm mt-auto align-self-start">@T["home.open"]</span>
        </a>
    </div>
    <div class="col-md-6 col-xl-4">
        <a class="card h-100 start-card text-decoration-none" href="/safety/index.html#/planner" target="_top">
            <div class="start-icon bg-dark">&#9638;</div>
            <h2>@T["start.planner.title"]</h2>
            <p class="text-muted">@T["start.planner.text"]</p>
            <span class="btn btn-outline-primary btn-sm mt-auto align-self-start">@T["home.open"]</span>
        </a>
    </div>
</div>
