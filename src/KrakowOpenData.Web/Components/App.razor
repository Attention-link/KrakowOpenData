@inject KrakowOpenData.Web.Assets.AssetVersions AssetUrls
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Kompas Krakowa</title>
    <meta name="theme-color" content="#070a0f" />
    <meta name="color-scheme" content="dark light" />
    <script>(function(){var t="dark";try{var s=localStorage.getItem("krakow-theme");if(s==="light"||s==="dark")t=s;}catch(e){}document.documentElement.setAttribute("data-bs-theme",t);})();</script>
    <link rel="icon" href="brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="brand/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="brand/icon-180.png" />
    <link rel="manifest" href="brand/site.webmanifest" />
    <link rel="stylesheet" href="@AssetUrls.Url("lib/sb-admin/styles.css")" />
    <link rel="stylesheet" href="@AssetUrls.Url("app.css")" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body class="sb-nav-fixed">
    <Routes @rendermode="InteractiveServer" />
    <script src="@AssetUrls.Url("lib/bootstrap/bootstrap.bundle.min.js")"></script>
    <script src="@AssetUrls.Url("js/layout.js")"></script>
    <script src="@AssetUrls.Url("js/language.js")"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
