@inherits LayoutComponentBase
@implements IDisposable
@inject LanguageState Language
@inject IJSRuntime JS

@* Cascades the current translator to every page and component (see LocalizedComponentBase). *@
<CascadingValue Value="Language.Current">
    <a class="skip-link visually-hidden-focusable" href="#main-content">@Language.Current["nav.skip"]</a>
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand ps-3 d-flex align-items-center gap-2" href="/">
            <img class="brand-mark" src="brand/favicon.svg" alt="" />
            <span>@Language.Current["brand.title"]</span>
        </a>
        <button class="btn btn-link btn-sm order-first ms-2 me-1 text-light" id="sidebarToggle" type="button" aria-label="@Language.Current["nav.menu"]" aria-controls="layoutSidenav_nav">&#9776;</button>
        <div class="ms-auto me-3 me-lg-4">
            <LanguageSwitcher OnSelect="SelectAsync" />
        </div>
    </nav>
    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark">
                <NavMenu />
                <div class="sb-sidenav-footer">
                    <div class="small">@Language.Current["brand.subtitle"]</div>
                </div>
            </nav>
        </div>
        <div id="layoutSidenav_content">
            <main class="container-fluid px-4 py-4" id="main-content" tabindex="-1">
                @Body
            </main>
            <footer class="py-3 bg-light mt-auto">
                <div class="container-fluid px-4 small text-muted">@Language.Current["brand.title"]</div>
            </footer>
        </div>
    </div>

    <div id="blazor-error-ui">
        @Language.Current["app.errorBar"] <a href="" class="reload">@Language.Current["app.reload"]</a>
    </div>
</CascadingValue>

@code {
    protected override void OnInitialized() => Language.Changed += OnLanguageChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            // Saved choice, or the browser's language on a first visit.
            var code = await JS.InvokeAsync<string?>("krakowLanguage.get");
            var language = AppLanguages.TryParse(code) ?? AppLanguages.Default;
            Language.Set(language);
            await JS.InvokeVoidAsync("krakowLanguage.set", language.Code());
        }
        catch (JSException)
        {
            // Script missing or storage blocked: keep the default language.
        }
    }

    private async Task SelectAsync(AppLanguage language)
    {
        Language.Set(language);
        try
        {
            await JS.InvokeVoidAsync("krakowLanguage.set", language.Code());
        }
        catch (JSException)
        {
        }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Language.Changed -= OnLanguageChanged;
}
