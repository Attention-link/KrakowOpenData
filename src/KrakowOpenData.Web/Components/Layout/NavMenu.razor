@using KrakowOpenData.Web.Navigation
@* Rendered from SiteMenu: the Kompas Krakowa app shows the same entries behind its "Menu" button, so every page has one menu. *@
<div class="sb-sidenav-menu">
<div class="nav">
    @foreach (var group in SiteMenu.Groups)
    {
        if (group.HeadingKey is { } heading)
        {
            <div class="sb-sidenav-menu-heading @(group.Features ? "feature-heading" : null)">@T[heading]</div>
        }
        foreach (var item in group.Items)
        {
            if (item.InApp)
            {
                @* The app is a separate page, not a Blazor route: target="_top" makes the browser load it instead of the router answering "Not found".
                   Staff-only entries (the planner dashboard) are marked differently: amber, with a lock. *@
                <a class="nav-link feature-link @(item.Staff ? "feature-staff" : null)" href="@item.Href" target="_top">
                    <span class="feature-icon" aria-hidden="true">@item.Icon</span>
                    <span>@T[item.LabelKey]</span>
                    @if (item.Staff)
                    {
                        <span class="staff-badge">@T["nav.staff"]</span>
                    }
                </a>
            }
            else
            {
                <NavLink class="nav-link" href="@item.Href" Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">@T[item.LabelKey]</NavLink>
            }
        }
    }
</div>
</div>
