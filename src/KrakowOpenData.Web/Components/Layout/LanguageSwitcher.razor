<div class="btn-group btn-group-sm" role="group" aria-label="@T["lang.label"]">
    @foreach (var language in AppLanguages.All)
    {
        var current = language == T.Language;
        <button type="button"
                class="btn @(current ? "btn-light" : "btn-outline-light")"
                aria-pressed="@(current ? "true" : "false")"
                title="@language.NativeName()"
                lang="@language.Code()"
                @onclick="() => OnSelect.InvokeAsync(language)">
            @language.ShortLabel()
        </button>
    }
</div>

@code {
    [Parameter] public EventCallback<AppLanguage> OnSelect { get; set; }
}
